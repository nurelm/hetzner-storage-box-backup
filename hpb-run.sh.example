#!/usr/bin/env bash
# hpb-run.sh.example — host-side wrapper for hetzner-storage-box-backup
#
# SETUP:
#   1. Copy this file to /usr/local/bin/hpb-run (no extension)
#   2. chmod +x /usr/local/bin/hpb-run
#   3. Copy example.hpb to .hpb in the directory where you'll run hpb-run, and fill in values
#   4. Run: hpb-run init
#   5. Run: hpb-run backup  (verify it works before enabling the cron)

set -eo pipefail

# ---------------------------------------------------------------------------
# Config file: reads all settings from .hpb in the current directory.
# Override with --config=<path> to use a different config file.
# ---------------------------------------------------------------------------

HPB_CONFIG=".hpb"
ARGS=()

for arg in "$@"; do
  case "$arg" in
    --config=*)
      HPB_CONFIG="${arg#--config=}"
      ;;
    *)
      ARGS+=("$arg")
      ;;
  esac
done

if [[ ! -f "$HPB_CONFIG" ]]; then
  echo "ERROR: config file not found: $HPB_CONFIG" >&2
  echo "Create a .hpb file in the current directory, or use --config=<path>" >&2
  exit 1
fi

# Load all settings from the config file
set -a
# shellcheck source=/dev/null
source "$HPB_CONFIG"
set +a

# Validate required settings
[[ -z "${IMAGE:-}" ]] && { echo "ERROR: IMAGE not set in $HPB_CONFIG" >&2; exit 1; }

# DOCKER_NETWORK is optional — only needed for backup (connecting to Postgres).
# snapshots, restore, init, forget, tag work without it.
NETWORK_ARG=""
if [[ -n "${DOCKER_NETWORK:-}" ]]; then
  NETWORK_ARG="--network $DOCKER_NETWORK"
fi

docker run --rm \
  $NETWORK_ARG \
  -e POSTGRES_CONTAINER \
  -e POSTGRES_DB \
  -e POSTGRES_USER \
  -e POSTGRES_PASSWORD \
  -e STORAGEBOX_HOST \
  -e STORAGEBOX_USER \
  -e STORAGEBOX_REPO_PATH \
  -e RESTIC_PASSWORD \
  -e KEEP_HOURLY \
  -e KEEP_DAILY \
  -e KEEP_WEEKLY \
  -v "${STORAGEBOX_SSH_KEY_PATH}":/tmp/storagebox_key:ro \
  "$IMAGE" \
  "${ARGS[@]}"
