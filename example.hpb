# hetzner-storage-box-backup config
# Copy to .hpb in the directory where you'll run hpb-run (or use --config=<path>).
# Permissions: chmod 600 .hpb
#
# See README.md for full documentation.

# ---------------------------------------------------------------------------
# Docker image (required)
# ---------------------------------------------------------------------------

# Pin to a specific version in production. Update here to upgrade.
# Available tags: https://hub.docker.com/r/nurelmdevelopment/hetzner-storage-box-backup/tags
IMAGE=nurelmdevelopment/hetzner-storage-box-backup:pg16.14-1.0.5

# ---------------------------------------------------------------------------
# Docker (only needed for backup — not for snapshots, restore, tag, init, forget)
# ---------------------------------------------------------------------------

# The Docker network where the Postgres container is reachable.
# Find yours with: docker network ls
DOCKER_NETWORK=kamal

# ---------------------------------------------------------------------------
# Postgres (used inside the container)
# ---------------------------------------------------------------------------

# The name of the Postgres container as it appears on the Docker network.
# Find yours with: docker ps
POSTGRES_CONTAINER=your-postgres-container-name

# The database to back up.
POSTGRES_DB=your_database_name

# Postgres credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Hetzner Storage Box (used inside the container)
# ---------------------------------------------------------------------------

# Storage Box hostname and username (they share the same uXXXXX identifier).
# Find both in the Hetzner Console under Storage Boxes.
STORAGEBOX_HOST=uXXXXX.your-storagebox.de
STORAGEBOX_USER=uXXXXX

# Path inside the Storage Box where this project's restic repo lives.
# Use a separate path per project if you share one Storage Box.
STORAGEBOX_REPO_PATH=/your-project-name

# Absolute path to the SSH private key on the host (authorized on the Storage Box).
# Never put the key contents here — point to the file.
STORAGEBOX_SSH_KEY_PATH=/root/.ssh/storagebox_key

# ---------------------------------------------------------------------------
# restic (used inside the container)
# ---------------------------------------------------------------------------

# Passphrase used to encrypt the restic repo.
# This is NOT the Storage Box password — it's a separate encryption key.
# Store it somewhere safe (e.g. a password manager). If you lose it,
# your backups are unreadable.
RESTIC_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Retention policy (optional — these are the defaults)
# ---------------------------------------------------------------------------
# Uncomment and adjust if you need different retention windows.

# KEEP_HOURLY=24
# KEEP_DAILY=14
# KEEP_WEEKLY=8
